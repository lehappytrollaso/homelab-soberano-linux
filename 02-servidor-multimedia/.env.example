# ==============================================================================
# VARIABLES DE ENTORNO · SUITE MULTIMEDIA & SERVARR
# ==============================================================================
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Directorio base de datos y medios (Estructura TRaSH Guides)
STORAGE_ROOT=/srv/storage/data

# Puertos expuestos en red local
PORT_JELLYFIN=8096
PORT_JELLYSEERR=5055
PORT_RADARR=7878
PORT_SONARR=8989
PORT_PROWLARR=9696
PORT_BAZARR=6767
PORT_QBITTORRENT=8080
PORT_FLARESOLVERR=8191

# Configuración de VPN opcional (Gluetun - WireGuard / OpenVPN)
# Si no usas VPN, qBittorrent se enlaza directamente a la red del host o bridge.
VPN_ENABLED=false
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=TU_CLAVE_PRIVADA_WIREGUARD
WIREGUARD_ADDRESSES=10.2.0.2/32
