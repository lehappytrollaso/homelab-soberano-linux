# ==============================================================================
# HOMELAB SOBERANO LINUX — VARIABLES MAESTRAS DE ENTORNO (PLANTILLA GENÉRICA)
# ==============================================================================
# Copia este archivo a .env y adapta los valores según tu infraestructura:
#   cp .env.example .env
# NUNCA compartas tu archivo .env con credenciales reales.
# ==============================================================================

# --- IDENTIDAD Y ZONA HORARIA DEL SISTEMA ---
# Ejecuta 'id $USER' en tu terminal para obtener tu PUID y PGID:
PUID=1000
PGID=1000
TZ=Europe/Madrid

# --- RUTAS DE ALMACENAMIENTO (ESTRUCTURA ATÓMICA TRASH GUIDES) ---
# Se recomienda un único punto de montaje para permitir enlaces duros (hardlinks):
STORAGE_ROOT=/srv/storage
MEDIA_DATA_DIR=/srv/storage/data
CONFIG_DIR=/srv/storage/config

# --- INFERENCIA IA (GOOGLE GEMINI 3.8 FLASH) ---
# Obtén tu clave en Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=AIzaSy_TU_CLAVE_API_DE_GEMINI_AQUI
DEFAULT_LLM_MODEL=gemini-3.8-flash-high

# --- PASARELA TELEGRAM ---
# Crea tu bot hablando con @BotFather en Telegram:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_ejemplo
# Obtén tu Chat ID enviando un mensaje a @userinfobot en Telegram:
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# --- PASARELA WHATSAPP (WAHA - WHATSAPP HTTP API) ---
WAHA_API_KEY=genera_un_token_aleatorio_muy_largo_aqui
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=genera_una_contrasena_robusta_aqui
WAHA_HOOK_HMAC_KEY=genera_un_secreto_hmac_sha256_aleatorio
# Tu número de teléfono personal en formato internacional E.164 (sin signos '+' ni espacios):
WHATSAPP_ALLOWED_PHONE=34600000000

# --- ECOSISTEMA MULTIMEDIA (API KEYS INTER-SERVICIOS) ---
# Se generan automáticamente al iniciar cada servicio en su panel web:
RADARR_API_KEY=clave_api_generada_en_radarr_settings_general
SONARR_API_KEY=clave_api_generada_en_sonarr_settings_general
PROWLARR_API_KEY=clave_api_generada_en_prowlarr_settings_general
BAZARR_API_KEY=clave_api_generada_en_bazarr_settings_general
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=contrasena_robusta_para_qbittorrent
