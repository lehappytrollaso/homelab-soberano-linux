# ==============================================================================
# VARIABLES DE ENTORNO · PASARELA WHATSAPP (WAHA)
# ==============================================================================
WAHA_API_KEY=genera_un_token_alfanumerico_largo_aqui
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=genera_una_contrasena_robusta_para_el_dashboard

# Secreto compartido HMAC SHA-256 para validar que los webhooks provienen de WAHA:
WHATSAPP_HOOK_HMAC_KEY=genera_un_secreto_hmac_sha256_aleatorio_muy_largo

# URL del webhook entregado a la interfaz del agente en el host
WHATSAPP_HOOK_URL=http://host.docker.internal:8088/webhook/waha
